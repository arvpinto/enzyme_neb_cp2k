#===============================================================================
# TS geometry optimization, dimer method  |  QM/MM (PBE / AMBER)  |  hsPLA2
#-------------------------------------------------------------------------------
# Required files in the run directory:
#   BASIS_SET, GTH_POTENTIALS        basis / pseudopotential libraries
#   hpla2_ee.prmtop                  AMBER topology (FF + connectivity)
#   ts.xyz                           TS guess coordinates
#   forceeval_qmmm.cp2k.inc          QM kinds, QM cell, link atoms
#   fixed_atoms.inc                  frozen atom list
#   vector.inc                       initial dimer vector
#===============================================================================


#===============================================================================
# GLOBAL
#===============================================================================
&GLOBAL
  PROJECT     DIMER
  RUN_TYPE    GEO_OPT
  PRINT_LEVEL LOW
  ECHO_INPUT
  SAVE_MEM
&END GLOBAL


#===============================================================================
# FORCE_EVAL - QM/MM energies and forces
#===============================================================================
&FORCE_EVAL
  METHOD        QMMM
  STRESS_TENSOR ANALYTICAL

  #-----------------------------------------------------------------------------
  # DFT - QM region
  #-----------------------------------------------------------------------------
  &DFT
    CHARGE                0
    MULTIPLICITY          1
    BASIS_SET_FILE_NAME   BASIS_SET
    POTENTIAL_FILE_NAME   GTH_POTENTIALS

    &QS
      METHOD GPW
    &END QS

    &MGRID
      CUTOFF 300
      COMMENSURATE
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS  RESTART
      EPS_SCF    1E-6
      MAX_SCF    60
      &OT
        MINIMIZER       DIIS
        PRECONDITIONER  FULL_SINGLE_INVERSE
        SAFE_DIIS       TRUE
      &END OT
      &OUTER_SCF
        EPS_SCF  1E-6
        MAX_SCF  30
      &END OUTER_SCF
    &END SCF
  &END DFT

  #-----------------------------------------------------------------------------
  # MM - AMBER force field and electrostatics
  #-----------------------------------------------------------------------------
  &MM
    &FORCEFIELD
      PARMTYPE       AMBER
      PARM_FILE_NAME hpla2_ee.prmtop
      EI_SCALE14     0.8333
      VDW_SCALE14    0.5000
      &SPLINE
        EMAX_SPLINE        1.0E8
        RCUT_NB [angstrom] 10
      &END SPLINE
    &END FORCEFIELD

    &POISSON
      POISSON_SOLVER PERIODIC
      PERIODIC       XYZ
      &EWALD
        EWALD_TYPE SPME
        ALPHA      .35
        GMAX       93 88 103
      &END EWALD
    &END POISSON
  &END MM

  #-----------------------------------------------------------------------------
  # QM/MM coupling
  #-----------------------------------------------------------------------------
  &QMMM
    ECOUPL       GAUSS
    USE_GEEP_LIB 6
    @INCLUDE forceeval_qmmm.cp2k.inc
  &END QMMM

  #-----------------------------------------------------------------------------
  # SUBSYS - cell, topology, atomic kinds
  #-----------------------------------------------------------------------------
  &SUBSYS

    &CELL
      ABC [angstrom]   9.3210001945495605E+01  8.8409994125366225E+01  1.0329999667406082E+02
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC         XYZ
      SYMMETRY         ORTHORHOMBIC
    &END CELL

    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME   ts.xyz
      CONN_FILE_FORMAT  AMBER
      CONN_FILE_NAME    hpla2_ee.prmtop
    &END TOPOLOGY

    #-- QM kinds: basis set and pseudopotential --------------------------------
    &KIND H
      BASIS_SET DZV-GTH-PBE
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND C
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND N
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND P
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND S
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND Ca
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q10
    &END KIND

    #-- MM kinds: element mapping for non-standard AMBER atom types ------------
    &KIND Na+
      ELEMENT Na
    &END KIND
    &KIND CL-
      ELEMENT Cl
    &END KIND
    &KIND Ca2
      ELEMENT Ca
    &END KIND
    &KIND OO
      ELEMENT O
    &END KIND
    &KIND HX1
      ELEMENT H
    &END KIND
    &KIND HX2
      ELEMENT H
    &END KIND
    &KIND HX3
      ELEMENT H
    &END KIND

  &END SUBSYS
&END FORCE_EVAL


#===============================================================================
# MOTION - TS search by the dimer method
#===============================================================================
&MOTION

  #-----------------------------------------------------------------------------
  # GEO_OPT - saddle point search
  #-----------------------------------------------------------------------------
  &GEO_OPT
    TYPE      TRANSITION_STATE
    OPTIMIZER CG
    MAX_ITER  5000
    MAX_DR    1.8E-03
    RMS_DR    1.2E-03
    MAX_FORCE 4.5E-04
    RMS_FORCE 3.0E-04

    &CG
      MAX_STEEP_STEPS 10
      &LINE_SEARCH
        TYPE 2PNT
        &2PNT
        &END 2PNT
      &END LINE_SEARCH
    &END CG

    &TRANSITION_STATE
      METHOD DIMER
      &DIMER
        DR [angstrom]         0.01
        ANGLE_TOLERANCE [deg] 1.5
        INTERPOLATE_GRADIENT  T

        &DIMER_VECTOR
          @INCLUDE vector.inc
        &END DIMER_VECTOR

        #-- Dimer rotation optimizer -----------------------------------------
        &ROT_OPT
          OPTIMIZER CG
          MAX_ITER  500
          &CG
            MAX_STEEP_STEPS 10
            &LINE_SEARCH
              TYPE 2PNT
              &2PNT
              &END 2PNT
            &END LINE_SEARCH
          &END CG
        &END ROT_OPT
      &END DIMER
    &END TRANSITION_STATE
  &END GEO_OPT

  #-----------------------------------------------------------------------------
  # CONSTRAINT
  #-----------------------------------------------------------------------------
  &CONSTRAINT
    &FIXED_ATOMS
      @INCLUDE fixed_atoms.inc
    &END FIXED_ATOMS
  &END CONSTRAINT

  #-----------------------------------------------------------------------------
  # PRINT
  #-----------------------------------------------------------------------------
  &PRINT
    &TRAJECTORY
      FORMAT   DCD
      ADD_LAST NUMERIC
      &EACH
        GEO_OPT 10
      &END EACH
    &END TRAJECTORY
    &RESTART
      ADD_LAST NUMERIC
    &END RESTART
    &RESTART_HISTORY
      ADD_LAST NUMERIC
    &END RESTART_HISTORY
  &END PRINT

&END MOTION
